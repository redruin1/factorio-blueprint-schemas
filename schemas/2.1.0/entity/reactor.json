    "allOf": [
        {"$ref": "../../2.0.0/entity.json"},
        {"$ref": "features/circuit-split-io.json"},
        {"$ref": "features/circuit-read-temperature.json"}
    ],
    "type": "object",
    "properties": {
        "control_behavior": {
            "type": "object",
