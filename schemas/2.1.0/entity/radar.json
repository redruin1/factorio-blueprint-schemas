{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "2.1.0/entity/radar.json",
    "title": "Radar",
    "description": "An entity which automatically charts and reveals neighbouring chunks.",
    "allOf": [
        {"$ref": "../../2.0.0/entity.json"}
    ],
    "properties": {
        "control_behavior": {
            "type": "object",
            "properties": {
                "mode": {
                    "title": "Radar Mode",
                    "description": "The manner in which circuit network signals should be broadcast to/from this radar.",
                    "oneOf": [
                        {
                            "title": "Surface",
                            "const": 1
                        },
                        {
                            "title": "Universe",
                            "const": 2
                        }
                    ]
                },
                "universe_channel": {
                    "title": "Universe Channel",
                    "description": "What unique channel this radar should use when `mode` is set to 'universe'.",
                    "$ref": "../../2.0.0/common/optional-signal-id.json"
                }
            }
        }
    }
}
