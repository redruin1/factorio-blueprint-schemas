{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "1.0.0/entity/logistic-container.json",
    "title": "Logistic Container",
    "description": "A container which acts as a node for the logistic network. Validates logistics chests of all 5 types, though some keys (`request_filters`) only apply to specific types.",
    "allOf": [
        {"$ref": "../entity.json"},
        {"$ref": "features/circuit-connectable.json"}
    ],
    "type": "object",
    "properties": {
        "bar": {"$ref": "../../common/limiting-bar.json"},
        "control_behavior": {
            "type": "object",
            "properties": {
                "circuit_mode_of_operation": {
                    "title": "Circuit Mode of Operation",
                    "description": "In what manner should this logistic chest interact with a connected circuit network. Only buffer and requester chests can modify this value to anything other than 'Read Contents'.",
                    "type": "integer",
                    "oneOf": [
                        {
                            "title": "Read Contents",
                            "const": 0
                        },
                        {
                            "title": "Set Requests",
                            "const": 1
                        }
                    ],
                    "default": 0
                }
            }
        },
        "request_filters": {
            "type": "array",
            "items": {
                "$ref": "../common/item-request.json"
            }
        },
        "request_from_buffers": {
            "type": "boolean",
            "default": false
        }
    }
}
